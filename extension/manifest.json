{
  "manifest_version": 3,
  "name": "Encrypt Social",
  "version": "0.4.0",
  "description": "End-to-end encryption for social media posts (ECDH P-256 + AES-GCM).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "scripts": ["crypto.js", "background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["crypto.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "encrypt-social@example.org",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}